<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.RECORD_AUDIO"/>
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
 <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
 <queries>
  <intent><action android:name="android.speech.RecognitionService"/></intent>
 </queries>
 <application android:theme="@style/AppTheme" android:label="Лёша">
  <activity android:name=".MainActivity" android:exported="true">
   <intent-filter>
    <action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/>
   </intent-filter>
  </activity>
  <service android:name=".VoiceClickService" android:exported="false"
   android:foregroundServiceType="microphone"/>
  <service android:name=".ClickAccessibilityService" android:exported="true"
   android:label="Лёша · нажатия" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
   <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
   <meta-data android:name="android.accessibilityservice" android:resource="@xml/click_accessibility_service"/>
  </service>
 </application>
</manifest>
